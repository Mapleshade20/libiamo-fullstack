		"svelte": "~5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"ts-fsrs": "^6.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"zod": "^4.6.7",
		"zxcvbn-typescript": "^5.0.1"
	},
	"packageManager": "pnpm@11.5.0",
