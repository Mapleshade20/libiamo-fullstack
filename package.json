{
	"name": "libiamo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check --write",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest run --reporter agent",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "~3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
		"openai": "^7.39.0",
		"postgres": "^4.1.1",
		"rough-notation": "^0.5.1",
		"svelte": "~5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@11.5.0",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#model/*": "./src/model/*"
	},
	"dependencies": {
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4"
	}
}
