{
	"name": "libiamo",
	"private": true,
	"version": "1.0.2",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check --write",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest run --reporter agent",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"case": "node lab/case.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
