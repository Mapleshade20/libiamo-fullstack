		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "~3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/emoji-js": "^3.5.2",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.2",
		"better-auth": "~1.7.21",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
