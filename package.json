{
	"name": "libiamo-fullstack",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check --write",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest run --reporter agent",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run --coverage",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "drizzle-kit migrate --config=drizzle.prod.config.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "latest",
		"@biomejs/biome": "2.4.10",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.7.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/emoji-js": "^3.5.2",
		"@types/node": "^24",
		"@types/nodemailer": "^7.0.11",
		"@vitest/coverage-v8": "^4.1.2",
		"better-auth": "~1.4.21",
		"bits-ui": "^2.16.4",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.20",
		"emoji-js": "^3.9.0",
		"emoji-picker-element": "^1.29.1",
		"marked": "^18.0.0",
		"nodemailer": "^8.0.4",
		"openai": "^6.39.0",
		"postgres": "^3.4.8",
		"rough-notation": "^0.5.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"svelte-rough-notation": "^0.2.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"ts-fsrs": "^5.4.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.1",
		"isomorphic-dompurify": "^3.9.0",
		"motion": "^12.42.2"
	},
	"packageManager": "pnpm@11.5.0"
}
