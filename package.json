{
	"name": "libiamo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check --write",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest run --reporter agent"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"bits-ui": "2.16.4",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
		"openai": "^7.39.0",
		"rough-notation": "^0.5.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^4.1.2",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@11.5.0"
}
