# Postgres 18 for Libiamo.
#
# Not published to the host: only containers in the pod can reach it.

[Unit]
Description=Libiamo database (Postgres 18)

[Container]
ContainerName=libiamo-db
Image=docker.io/library/postgres:18.6-alpine
Pod=libiamo.pod

# Postgres 18 keeps its cluster in /var/lib/postgresql/18/docker and declares the
# volume at /var/lib/postgresql — NOT the pre-18 /var/lib/postgresql/data.
# Mounting the old path silently starts an empty cluster.
Volume=libiamo-db.volume:/var/lib/postgresql

EnvironmentFile=%h/.config/libiamo/db.env

# Hardcoded rather than ${POSTGRES_USER}: systemd would try to expand that during
# unit generation. Update here too if you change the user/database name.
HealthCmd=pg_isready -U libiamo -d libiamo
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s

LogDriver=journald

[Service]
Restart=always
# initdb on first boot takes a while.
TimeoutStartSec=300

[Install]
WantedBy=default.target
