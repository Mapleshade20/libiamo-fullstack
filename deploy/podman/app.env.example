# Installed to ~/.config/libiamo/app.env (mode 600).
#
# Only the app container reads this file. What each variable does: DEPLOYMENT.md,
# "Configuration reference".

# --- Public address ----------------------------------------------------------
# Bare origin, no trailing path, must match the browser URL exactly. adapter-node
# derives every request URL from it and Better Auth builds email links from it.
ORIGIN=https://libiamo.net

# --- Database ----------------------------------------------------------------
# Host is the container name: podman resolves it over the shared `libiamo`
# network. The password must match POSTGRES_PASSWORD in db.env.
DATABASE_URL=postgres://libiamo:CHANGE_ME@libiamo-db:5432/libiamo

RUN_MIGRATIONS=1

# --- Accounts ----------------------------------------------------------------
# openssl rand -base64 32 (32+ characters). Signs sessions and encrypts learners'
# keys: changing it ends every session and makes saved keys unreadable.
BETTER_AUTH_SECRET=CHANGE_ME

# Verified addresses that become admins when they sign in (comma-separated).
ADMIN_EMAILS=

# OAuth providers are offered only when both values for that provider are set.
# Callbacks: ${ORIGIN}/api/auth/callback/google and /github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP --------------------------------------------------------------------
# Required: confirming the address is how an account starts.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_FROM=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# --- Models ------------------------------------------------------------------
# The server's own calls until learners' keys arrive (phase 2 of the rebuild).
OPENROUTER_API_KEY=

# --- Abuse protection --------------------------------------------------------
# Only once the reverse proxy sets this header (DEPLOYMENT.md, "Reverse proxy").
ADDRESS_HEADER=X-Real-IP
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_AUDIT_LOG=0

# --- Misc --------------------------------------------------------------------
TZ=Asia/Shanghai
BODY_SIZE_LIMIT=20M
DB_DEBUG=0
