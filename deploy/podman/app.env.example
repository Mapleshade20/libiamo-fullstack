# Installed to ~/.config/libiamo/app.env (mode 600).
#
# Only the app container reads this file. What each variable does: DEPLOYMENT.md,
# "Configuration reference".

# --- Public address ----------------------------------------------------------
# Bare origin, no trailing path, must match the browser URL exactly. adapter-node
# derives every request URL from it and Better Auth builds email links from it.
ORIGIN=https://libiamo.net

# --- Database ----------------------------------------------------------------
# Host is the container name: podman resolves it over the shared `libiamo`
# network. The password must match POSTGRES_PASSWORD in db.env.
DATABASE_URL=postgres://libiamo:CHANGE_ME@libiamo-db:5432/libiamo

RUN_MIGRATIONS=1

# --- Auth --------------------------------------------------------------------
# openssl rand -base64 32 ; changing it invalidates every session.
BETTER_AUTH_SECRET=CHANGE_ME

# OAuth providers are enabled only when both values for that provider are set.
# Callbacks: ${ORIGIN}/api/auth/callback/google and /github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- SMTP --------------------------------------------------------------------
# Required: sign-up needs email verification.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_FROM=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
TRIAL_TOKEN_BUDGET=50000
TRIAL_TOKEN_HOLD=4096

# --- Abuse protection --------------------------------------------------------
# Only once the reverse proxy sets this header (DEPLOYMENT.md, "Reverse proxy").
ADDRESS_HEADER=X-Real-IP
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_AUDIT_LOG=0

# --- Misc --------------------------------------------------------------------
TZ=Asia/Shanghai
BODY_SIZE_LIMIT=20M
LLM_DEBUG=0
DB_DEBUG=0
