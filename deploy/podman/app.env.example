# Installed to ~/.config/libiamo/app.env (mode 600).
#
# Only the app container reads this file.

# --- Public address ----------------------------------------------------------
# Bare origin, no trailing path, must match the browser URL exactly. adapter-node
# derives every request URL from it and Better Auth builds email links from it.
ORIGIN=https://app.libiamo.net

# --- Database ----------------------------------------------------------------
# 127.0.0.1, NOT the service name: containers in a pod share a network namespace.
# The password must match POSTGRES_PASSWORD in db.env.
DATABASE_URL=postgres://libiamo:CHANGE_ME@127.0.0.1:5432/libiamo

# Applied by the entrypoint on every start, before the server listens.
RUN_MIGRATIONS=true

# --- Auth --------------------------------------------------------------------
# openssl rand -base64 32 ; changing it invalidates every session.
BETTER_AUTH_SECRET=CHANGE_ME

# --- SMTP --------------------------------------------------------------------
# Required: sign-up needs email verification.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
TRIAL_TOKEN_BUDGET=50000

# --- Misc --------------------------------------------------------------------
TZ=Asia/Shanghai
# adapter-node's own default is only 512K.
BODY_SIZE_LIMIT=20M
LLM_DEBUG=false
DB_DEBUG=0
