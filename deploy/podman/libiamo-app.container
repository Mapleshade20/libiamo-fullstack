# Libiamo application server.
#
# Migrations are applied by the image entrypoint before the server listens, and
# it retries for ~30s, which covers Postgres still starting up. That is why this
# unit only needs ordering against the database, not health gating.
#
# To update: change the Image tag below, then
#   systemctl --user daemon-reload && systemctl --user restart libiamo-app

[Unit]
Description=Libiamo app
Requires=libiamo-db.service
After=libiamo-db.service

[Container]
ContainerName=libiamo-app
Image=ghcr.io/mapleshade20/libiamo:latest
Network=libiamo.network

# Bound to loopback: terminate TLS in the host's reverse proxy.
PublishPort=127.0.0.1:3000:3000

EnvironmentFile=%h/.config/libiamo/app.env

# Enables `podman auto-update` to pull a newer digest for this tag and restart.
# Only meaningful with a moving tag such as :latest; drop it when pinning a
# version you intend to change by hand.
AutoUpdate=registry

# Declared here rather than relying on the image's HEALTHCHECK: an image built
# in OCI format drops that field, so it cannot be counted on.
# Append the base path if the image was built with a non-empty BASE_PATH.
HealthCmd=wget -qO /dev/null http://127.0.0.1:3000/health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s

# k8s-file rather than journald: a conmon built without journald support fails
# outright ("Include journald in compilation path"). Use `podman logs` to read
# container output; systemd still journals the unit's own lifecycle.
LogDriver=k8s-file
LogOpt=max-size=10mb

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
