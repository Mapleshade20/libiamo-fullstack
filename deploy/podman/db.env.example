# Installed to ~/.config/libiamo/db.env (mode 600).
#
# Only the database container reads this file. POSTGRES_PASSWORD must match the
# password inside DATABASE_URL in app.env.
#
# These values are read only when the cluster is first created. Changing them
# later does NOT change the existing database.

POSTGRES_DB=libiamo
POSTGRES_USER=libiamo
POSTGRES_PASSWORD=CHANGE_ME

POSTGRES_INITDB_ARGS=--encoding=UTF8
TZ=Asia/Shanghai
