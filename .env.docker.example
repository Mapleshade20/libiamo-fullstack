# Runtime configuration for the Docker deployment.
#
#   cp .env.docker.example .env.docker
#   chmod 600 .env.docker
#   docker compose --env-file .env.docker up -d
#
# Never commit the filled-in copy.

# --- Image -------------------------------------------------------------------
# Pin a released tag in production; :latest is only convenient for trying it out.
APP_IMAGE=ghcr.io/mapleshade20/libiamo:latest

# --- Public address ----------------------------------------------------------
# Bare origin, no trailing path. adapter-node derives every request URL from it,
# and Better Auth builds verification/reset links from it.
ORIGIN=https://app.libiamo.net

# Where the container listens on the host. Keep it on loopback and let your
# reverse proxy terminate TLS.
APP_BIND=127.0.0.1
APP_PORT=3000

# --- Database ----------------------------------------------------------------
# Bundled Postgres 18: host is the compose service name `database`. The password
# here must match POSTGRES_PASSWORD below.
POSTGRES_DB=libiamo
POSTGRES_USER=libiamo
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
DATABASE_URL=postgres://libiamo:CHANGE_ME_GENERATE_A_STRONG_PASSWORD@database:5432/libiamo

# To use an external Postgres instead, point DATABASE_URL at it and start with
#   docker compose --env-file .env.docker up -d app
# Use host.docker.internal (or the host's LAN IP) to reach a database running on
# the Docker host itself.
# DATABASE_URL=postgres://libiamo:...@host.docker.internal:5432/libiamo

# Migrations run automatically on container start. Set false if you prefer to
# apply them out of band.
RUN_MIGRATIONS=true

# --- Auth --------------------------------------------------------------------
# 32+ chars, high entropy:  openssl rand -base64 32
# Changing this invalidates every existing session.
BETTER_AUTH_SECRET=CHANGE_ME

# --- SMTP --------------------------------------------------------------------
# Required for sign-up: email verification is mandatory.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# Output token budget for non-BYOK users.
TRIAL_TOKEN_BUDGET=50000

# --- Misc --------------------------------------------------------------------
TZ=Asia/Shanghai
# adapter-node's own default is only 512K.
BODY_SIZE_LIMIT=20M
# Verbose logging; leave off in production.
LLM_DEBUG=false
DB_DEBUG=0
