      "policies": {},
      "checkConstraints": {
        "user_role_check": {
          "name": "user_role_check",
          "value": "\"user\".\"role\" in ('learner', 'admin')"
        },
        "user_native_language_check": {
          "name": "user_native_language_check",
          "value": "\"user\".\"native_language\" is null or \"user\".\"native_language\" in ('en', 'ru', 'es', 'de', 'tr', 'fa', 'fr', 'ja', 'pt', 'zh-CN', 'vi', 'it', 'ar', 'pl', 'el', 'nl', 'id', 'ko')"
        },
        "user_learning_languages_check": {
          "name": "user_learning_languages_check",
          "value": "\"user\".\"learning_languages\" <@ array['en', 'es', 'fr', 'de', 'it', 'pt', 'ja', 'ko', 'zh-CN', 'ru', 'ar', 'nl', 'tr', 'pl']::text[]"
        },
        "user_active_language_check": {
          "name": "user_active_language_check",
          "value": "\"user\".\"active_language\" is null or \"user\".\"active_language\" = any(\"user\".\"learning_languages\")"
        },
        "user_tutor_language_check": {
          "name": "user_tutor_language_check",
          "value": "\"user\".\"tutor_language\" in ('native', 'target')"
        },
        "user_weekly_goal_check": {
          "name": "user_weekly_goal_check",
          "value": "\"user\".\"weekly_goal\" between 1 and 7"
        },
        "user_onboarded_check": {
          "name": "user_onboarded_check",
          "value": "\"user\".\"onboarded_at\" is null or (\"user\".\"native_language\" is not null and \"user\".\"active_language\" is not null)"
        }
      },
