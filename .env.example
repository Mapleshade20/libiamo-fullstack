# What each variable does: DEPLOYMENT.md, "Configuration reference". src/env.ts declares and checks them.

DATABASE_URL="postgres://user:password@localhost:5432/libiamo"
# The dev server listens on 127.0.0.1:5173; Better Auth accepts requests only from this origin.
ORIGIN="http://127.0.0.1:5173"
ADDRESS_HEADER="" # empty without a reverse proxy
DB_DEBUG="0"

# Accounts. 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=""
ADMIN_EMAILS="" # comma-separated; these become admins once verified and signed in
AUTH_AUDIT_LOG="0"
# OAuth (callback: ${ORIGIN}/api/auth/callback/{provider}); a provider is offered only with both values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Turnstile, both or neither. Cloudflare's test keys need a click, so leave them empty to sign up from a script.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Mail. Sent only with SMTP_HOST, SMTP_USER and SMTP_PASS; with any of them empty the mails (and their links) are
# printed to the server's console.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="1"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASS=""

# The service's own key, for the calls no learner makes (the composer's gate). Learners' calls use their own key.
OPENROUTER_API_KEY=""

# Development only: answer model calls from a cache (lab/record.mjs, lab/replay.mjs), and with LLM_CACHE_ONLY
# refuse to spend when a call is not in it.
# LLM_CACHE_DIR="lab/baseline/cache"
# LLM_CACHE_ONLY="1"
