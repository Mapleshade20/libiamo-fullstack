# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# SMTP (Alibaba)
SMTP_HOST="smtpdm.aliyun.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_FROM=""
SMTP_USER="" # the same as SMTP_FROM
SMTP_PASS=""

# OpenAI-compatible API
OPENAI_API_KEY="***"
OPENAI_BASE_URL="https://lab.cs.tsinghua.edu.cn/ai-platform/api/v1"
OPENAI_MODEL="deepseek-v4-flash"
TRIAL_TOKEN_BUDGET="50000" # visible output token budget for non-BYOK users
LLM_DEBUG="false" # set to true to log LLM request/response bodies in the server console
