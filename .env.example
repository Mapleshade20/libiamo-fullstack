# What each variable does: DEPLOYMENT.md, "Configuration reference".

# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN="http://localhost:5173"
ADDRESS_HEADER="" # empty without a reverse proxy

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google and GitHub OAuth
# Callback: ${ORIGIN}${BASE_PATH}/api/auth/callback/{provider}
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# SMTP (Alibaba)
SMTP_HOST="smtpdm.aliyun.com"
SMTP_PORT="465"
SMTP_SECURE="1"
SMTP_FROM=""
SMTP_USER="" # the same as SMTP_FROM
SMTP_PASS=""

# OpenAI-compatible API
OPENAI_API_KEY="***"
OPENAI_BASE_URL="https://lab.cs.tsinghua.edu.cn/ai-platform/api/v1"
OPENAI_MODEL="deepseek-v4-flash"
TRIAL_TOKEN_BUDGET="50000"
TRIAL_TOKEN_HOLD="4096"
LLM_DEBUG="0"

# LLM Lab (docs/design/2026-09-24-llm-lab.md)
LLM_LAB="1"
LLM_LAB_PROVIDERS='[]' # JSON array of {"id","label","baseUrl","apiKey","model"} that admins can pick in the Lab
LLM_LAB_CONCURRENCY="3"

# Cloudflare's Turnstile test keys: they work on localhost, always show a challenge to click and
# always pass. Others: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY="3x00000000000000000000FF"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

AUTH_AUDIT_LOG="0"
