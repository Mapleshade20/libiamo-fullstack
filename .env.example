# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google and GitHub OAuth
# Callback: ${ORIGIN}${BASE_PATH}/api/auth/callback/{provider}
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# SMTP (Alibaba)
SMTP_HOST="smtpdm.aliyun.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_FROM=""
SMTP_USER="" # the same as SMTP_FROM
SMTP_PASS=""

# OpenAI-compatible API
OPENAI_API_KEY="***"
OPENAI_BASE_URL="https://lab.cs.tsinghua.edu.cn/ai-platform/api/v1"
OPENAI_MODEL="deepseek-v4-flash"
TRIAL_TOKEN_BUDGET="50000" # provider-reported output token budget for non-BYOK users, including reasoning/thinking tokens
TRIAL_TOKEN_HOLD="4096" # tokens each trial call holds before the provider answers; settled to actual usage afterwards
LLM_DEBUG="false" # set to true to log LLM request/response bodies in the server console

# LLM Lab (docs/design/2026-09-24-llm-lab.md)
LLM_LAB="on" # "off" disables tracing, staff overrides and the Lab worker
LLM_LAB_PROVIDERS='[]' # JSON array of {"id","label","baseUrl","apiKey","model"} that admins can pick in the Lab; never debits trial quota
LLM_LAB_CONCURRENCY="3" # parallel Lab run calls

# Cloudflare Turnstile on sign-up and password reset; leave both empty to turn the check off
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

AUTH_AUDIT_LOG="false" # set to true to log sign-ups, email/password changes and login-method links as one JSON line each ({"type":"auth-audit",...})
